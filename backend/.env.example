# Postgres connection string from Neon or Supabase (postgres:// or postgresql:// both work)
DATABASE_URL=
# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
# From https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# How long gpt-oss thinks before answering: low / medium / high. Leave empty for other models.
GROQ_REASONING_EFFORT=low
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Used only by scripts/seed.py to create the demo accounts
ADMIN_USERNAME=
ADMIN_PASSWORD=
DEMO_USERNAME=
DEMO_PASSWORD=